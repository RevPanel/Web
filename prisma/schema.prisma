generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String  @id @unique
  name       String
  username   String  @unique
  email      String  @unique
  resetToken String? @unique

  auth_session Session[]
  key          Key[]
  apiKeys      ApiKey[]
  servers      Server[]
  logs         UserLogs[]
  serverMember ServerMember[]
}

model Session {
  id             String @id @unique
  user_id        String
  active_expires BigInt
  idle_expires   BigInt
  user           User   @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model Key {
  id              String  @id @unique
  hashed_password String?
  user_id         String
  user            User    @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model ApiKey {
  id          Int      @id @default(autoincrement())
  key         String   @unique @default(cuid())
  description String
  ips         String[]
  createdAt   DateTime @default(now())

  owner   User   @relation(references: [id], fields: [ownerId], onDelete: Cascade)
  ownerId String
}

enum InstallStatus {
  STARTED
  SUCCESS
  FAILED
}

model Server {
  id          String         @id @default(cuid())
  name        String
  description String?
  ip          String
  key         String
  owner       User           @relation(references: [id], fields: [ownerId], onDelete: Cascade)
  ownerId     String
  status      InstallStatus  @default(STARTED)
  createdAt   DateTime       @default(now())
  members     ServerMember[]
}

model ServerMember {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  permissions String[]

  server   Server @relation(references: [id], fields: [serverId], onDelete: Cascade)
  serverId String
  user     User   @relation(references: [id], fields: [userId], onDelete: Cascade)
  userId   String
}

model UserLogs {
  id        Int        @id @default(autoincrement())
  action    UserAction
  data      String?
  createdAt DateTime   @default(now())

  user   User   @relation(references: [id], fields: [userId], onDelete: Cascade)
  userId String
}

model ImageConfiguration {
  id String @id @default(cuid())

  name        String
  description String
  version     String
  homepage    String?
  mountPath   String?
  createdAt   DateTime @default(now())

  environments String[]
  ports        ImagePort[]
  dockerImage  String
}

model ImagePort {
  id   Int    @id @default(autoincrement())
  name String

  containerPort Int

  image   ImageConfiguration @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId String
}

enum UserAction {
  LOGIN
  REGISTER
  CREATE_SEVRER
}
