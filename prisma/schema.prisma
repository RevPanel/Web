generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstallStatus {
  STARTED
  SUCCESS
  FAILED
}

model Server {
  id          String        @id @default(uuid())
  name        String
  description String?
  ip          String
  key         String
  owner       String
  status      InstallStatus @default(STARTED)
  createdAt   DateTime      @default(now())
}
