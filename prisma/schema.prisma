generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @unique
  name            String
  username        String  @unique
  avatarUrl       String?
  email           String  @unique
  emailToken      String? @unique @default(cuid())
  emailVerified   Boolean @default(false)
  resetToken      String? @unique
  plan            String?
  stripeId        String? @unique
  serverCreated   Boolean @default(false)
  admin           Boolean @default(false)
  twoFactorSecret String?
  hashed_password String?

  sessions      Session[]
  oauthAccounts OauthAccount[]
  logs          UserLogs[]
  servers       Server[]
}

model OauthAccount {
  providerId     String
  providerUserId String
  userId         String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([providerId, providerUserId])
}

model Session {
  id         String   @id @unique
  userId     String
  expiresAt  DateTime
  address    String
  user_agent String
  user       User     @relation(references: [id], fields: [userId], onDelete: Cascade)
}

model UserLogs {
  id        Int        @id @default(autoincrement())
  action    UserAction
  data      String?
  createdAt DateTime   @default(now())

  user   User   @relation(references: [id], fields: [userId], onDelete: Cascade)
  userId String
}

model ImageConfiguration {
  id String @id @default(cuid())

  name        String
  description String
  version     String
  homepage    String?
  mountPath   String?
  createdAt   DateTime @default(now())

  environments String[]
  ports        ImagePort[]
  dockerImage  String
}

model ImagePort {
  id   Int    @id @default(autoincrement())
  name String

  containerPort Int

  image   ImageConfiguration @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId String
}

enum UserAction {
  LOGIN
  REGISTER
  CREATE_SEVRER
}

model Server {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  createdAt DateTime @default(now())
  url       String @unique
  token     String @unique

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}
