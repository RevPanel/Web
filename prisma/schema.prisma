generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String  @id @unique
  name       String
  username   String  @unique
  email      String  @unique
  resetToken String? @unique

  auth_session Session[]
  key          Key[]
  servers      Server[]
  logs         UserLogs[]
}

model Session {
  id             String @id @unique
  user_id        String
  active_expires BigInt
  idle_expires   BigInt
  user           User   @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model Key {
  id              String  @id @unique
  hashed_password String?
  user_id         String
  user            User    @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
}

enum InstallStatus {
  STARTED
  SUCCESS
  FAILED
}

model Server {
  id          String        @id @default(cuid())
  name        String
  description String?
  ip          String
  key         String
  owner       User          @relation(references: [id], fields: [ownerId], onDelete: Cascade)
  ownerId     String
  status      InstallStatus @default(STARTED)
  createdAt   DateTime      @default(now())
}

model UserLogs {
  id        Int        @id @default(autoincrement())
  action    UserAction
  data      String?
  createdAt DateTime   @default(now())

  user   User   @relation(references: [id], fields: [userId], onDelete: Cascade)
  userId String
}

enum UserAction {
  LOGIN
  REGISTER
  CREATE_SEVRER
}
